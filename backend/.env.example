# Copy this file to .env (never commit .env).
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters
PORT=4000
CORS_ORIGIN=http://localhost:5173
# DB_FILE=./data/genmed.db

# Doctor account. Patients register themselves on the website, but public sign-up can never
# create a doctor, so the doctor account is created from these values when the server starts
# (only if that email does not exist yet). Password: 8-128 characters with an uppercase
# letter, a lowercase letter and a number.
DOCTOR_NAME=Dr Your Name
DOCTOR_EMAIL=doctor@genmed.local
DOCTOR_PASSWORD=
