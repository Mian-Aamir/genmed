{
  "name": "genmed-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GenMed backend API (Development Activity 6): Express + SQLite + JWT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:reset": "node --env-file-if-exists=.env src/scripts/resetDb.js",
    "db:show": "node --env-file-if-exists=.env src/scripts/showDb.js",
    "db:browse": "node --env-file-if-exists=.env src/scripts/dbBrowser.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
